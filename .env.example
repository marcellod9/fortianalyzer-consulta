# URL do FortiAnalyzer (sem /jsonrpc no final)
FAZ_URL=https://fortianalyzer.exemplo.local
# Token de API do usuário REST criado no FortiAnalyzer (nunca commitar o valor real)
FAZ_API_TOKEN=
# Verificação TLS: "true", "false" ou caminho para o bundle da CA interna
FAZ_VERIFY_TLS=true
# ADOM padrão quando a interface não informar
FAZ_DEFAULT_ADOM=root
# Limites da busca
FAZ_MAX_RESULTS=1000
FAZ_SEARCH_TIMEOUT=120
# "true" usa um FortiAnalyzer simulado (para desenvolvimento e demonstração)
FAZ_MOCK=false
