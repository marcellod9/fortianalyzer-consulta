# =====================================================================
#  FortiLogPortal - configuração local
#  Copie este arquivo para config\.env e preencha os valores.
#  O arquivo config\.env NÃO deve ser versionado nem compartilhado.
# =====================================================================

# ---- Aplicação --------------------------------------------------------
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000
# DEBUG, INFO, WARNING, ERROR
PORTAL_LOG_LEVEL=INFO
# Modo demonstração: usa dados simulados no lugar das APIs reais.
# Mantenha "false" para consultar o FortiAnalyzer e o Vision One de verdade.
PORTAL_DEMO=false
# Tempo (segundos) que resultados ficam no cache local (SQLite)
PORTAL_CACHE_TTL=600

# ---- FortiAnalyzer ----------------------------------------------------
# URL do FortiAnalyzer (sem /jsonrpc no final)
FAZ_URL=https://fortianalyzer.marista.edu.br
# Token do administrador "REST API Admin" (somente leitura)
FAZ_API_TOKEN=
# Verificação TLS: true, false, ou caminho para o arquivo .pem da CA interna
FAZ_VERIFY_TLS=true
# ADOM padrão
FAZ_DEFAULT_ADOM=root
# Limite de linhas por consulta e tempo limite da busca (segundos)
FAZ_MAX_RESULTS=1000
FAZ_SEARCH_TIMEOUT=120
# Buscas simultâneas no FAZ (1 = uma por vez; o FAZ pode recusar buscas paralelas do mesmo admin)
FAZ_PARALLEL_SEARCHES=1
# Relatórios: eventos lidos por tipo de log para montar os gráficos (os mais recentes do período)
REPORT_MAX_ROWS=5000
# Relatório por usuário, IP, site ou aplicação: lê mais eventos, para a lista detalhada sair completa
REPORT_MAX_ROWS_FILTRADO=20000

# ---- Login Microsoft Entra ID (SSO com MFA) -------------------------
# Passo a passo em docs\CONFIGURACAO_ENTRA.md
# off = sem login (POC local) | entra = exige login com a conta Microsoft
AUTH_MODE=off
# Visão geral do registro de aplicativo: ID do diretório (locatário) e ID do aplicativo (cliente)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Segredo do cliente (Certificados e segredos). Prefira certificado: ENTRA_CERT_PATH (.pem com chave) + thumbprint
ENTRA_CLIENT_SECRET=
# ENTRA_CERT_PATH=C:\FortiLogPortal\config\entra-portal.pem
# ENTRA_CERT_THUMBPRINT=
# Igual à URI cadastrada no Entra (plataforma Web). Padrão: http://localhost:8000/auth/callback
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
# Opcional: contexto de autenticação ligado ao MFA no Acesso Condicional (ex.: c1). Vazio = só a política do app
ENTRA_AUTH_CONTEXT=
# Login mais antigo que isso (minutos) pede autenticação de novo na Microsoft
ENTRA_MAX_AGE_MIN=480
# Administradores do portal (aba Acessos), e-mails separados por vírgula
PORTAL_ADMINS=
# Funções de aplicativo (App roles) do Entra que também dão acesso
ENTRA_ROLE_ADMIN=Portal.Admin
ENTRA_ROLE_RELATORIOS=Relatorios.Emitir
# Sessão: duração máxima (horas) e encerramento por inatividade (minutos)
PORTAL_SESSION_HOURS=8
PORTAL_SESSION_IDLE_MIN=60

# ---- Trend Micro Vision One ------------------------------------------
# URL da API da região do tenant (portal.xdr.trendmicro.com = região EUA)
#   EUA: https://api.xdr.trendmicro.com        Europa: https://api.eu.xdr.trendmicro.com
#   Japão: https://api.xdr.trendmicro.co.jp    Singapura: https://api.sg.xdr.trendmicro.com
#   Austrália: https://api.au.xdr.trendmicro.com  Índia: https://api.in.xdr.trendmicro.com
#   Oriente Médio/África: https://api.mea.xdr.trendmicro.com
V1_BASE_URL=https://api.xdr.trendmicro.com
# Chave de API gerada em Administration > API Keys (função somente leitura)
V1_API_TOKEN=
V1_VERIFY_TLS=true
# Janela (dias) para procurar detecções e alertas relacionados a um indicador
V1_LOOKBACK_DAYS=30
# Ameaças > Trend inativo: máximo de endpoints lidos do inventário do Vision One (fica 30 min em cache).
# A lista traz os gerenciados e os só descobertos (Unmanaged endpoints): use um valor acima da soma dos dois.
V1_INVENTORY_MAX=60000
# Permite enviar URLs ao Sandbox (consome cota de análises do tenant)
V1_SANDBOX_ENABLED=false
# Consultas (TMV1-Query) para localizar detecções de um indicador; {v} = valor pesquisado
V1_DETECTION_QUERY_URL=request:"{v}"
V1_DETECTION_QUERY_DOMAIN=request:"*{v}*"
V1_DETECTION_QUERY_IP=dst:"{v}" or src:"{v}"

# ---- Atualização (scripts\update.bat) -------------------------------
# UPDATE_REPO=marcellod9/fortianalyzer-consulta
# UPDATE_BRANCH=main

# ---- Proxy corporativo (opcional) ------------------------------------
# HTTPS_PROXY=http://proxy.marista.local:8080
# NO_PROXY=fortianalyzer.marista.edu.br
