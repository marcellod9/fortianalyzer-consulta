# =====================================================================
#  FortiLogPortal - configuração local
#  Copie este arquivo para config\.env e preencha os valores.
#  O arquivo config\.env NÃO deve ser versionado nem compartilhado.
# =====================================================================

# ---- Aplicação --------------------------------------------------------
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8000
# DEBUG, INFO, WARNING, ERROR
PORTAL_LOG_LEVEL=INFO
# Modo demonstração: usa dados simulados no lugar das APIs reais.
# Mantenha "false" para consultar o FortiAnalyzer e o Vision One de verdade.
PORTAL_DEMO=false
# Tempo (segundos) que resultados ficam no cache local (SQLite)
PORTAL_CACHE_TTL=600

# ---- FortiAnalyzer ----------------------------------------------------
# URL do FortiAnalyzer (sem /jsonrpc no final)
FAZ_URL=https://fortianalyzer.marista.edu.br
# Token do administrador "REST API Admin" (somente leitura)
FAZ_API_TOKEN=
# Verificação TLS: true, false, ou caminho para o arquivo .pem da CA interna
FAZ_VERIFY_TLS=true
# ADOM padrão
FAZ_DEFAULT_ADOM=root
# Limite de linhas por consulta e tempo limite da busca (segundos)
FAZ_MAX_RESULTS=1000
FAZ_SEARCH_TIMEOUT=120
# Buscas simultâneas no FAZ (1 = uma por vez; o FAZ pode recusar buscas paralelas do mesmo admin)
FAZ_PARALLEL_SEARCHES=1

# ---- Trend Micro Vision One ------------------------------------------
# URL da API da região do tenant (portal.xdr.trendmicro.com = região EUA)
#   EUA: https://api.xdr.trendmicro.com        Europa: https://api.eu.xdr.trendmicro.com
#   Japão: https://api.xdr.trendmicro.co.jp    Singapura: https://api.sg.xdr.trendmicro.com
#   Austrália: https://api.au.xdr.trendmicro.com  Índia: https://api.in.xdr.trendmicro.com
#   Oriente Médio/África: https://api.mea.xdr.trendmicro.com
V1_BASE_URL=https://api.xdr.trendmicro.com
# Chave de API gerada em Administration > API Keys (função somente leitura)
V1_API_TOKEN=
V1_VERIFY_TLS=true
# Janela (dias) para procurar detecções e alertas relacionados a um indicador
V1_LOOKBACK_DAYS=30
# Permite enviar URLs ao Sandbox (consome cota de análises do tenant)
V1_SANDBOX_ENABLED=false
# Consultas (TMV1-Query) para localizar detecções de um indicador; {v} = valor pesquisado
V1_DETECTION_QUERY_URL=request:"{v}"
V1_DETECTION_QUERY_DOMAIN=request:"*{v}*"
V1_DETECTION_QUERY_IP=dst:"{v}" or src:"{v}"

# ---- Proxy corporativo (opcional) ------------------------------------
# HTTPS_PROXY=http://proxy.marista.local:8080
# NO_PROXY=fortianalyzer.marista.edu.br
